# Copy this to .env for LOCAL testing only (never commit a real .env).
# In GitHub Actions, these are set as repo Secrets/Variables instead —
# see README.md "5. Add the keys to GitHub" section.

# --- Secrets (keep these private) ---
ANTHROPIC_API_KEY=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
UNSPLASH_ACCESS_KEY=

# --- Variables (not secret, just settings) ---
PAGE_NAME=Your Page Name
POST_LANGUAGE=bn
AUTO_PUBLISH=false
